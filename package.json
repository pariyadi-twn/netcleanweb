{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": "26.5.x",
        "npm": "12.x"
    },
    "packageManager": "npm@12.0.1",
    "scripts": {
        "lint:api": "node --input-type=module -e \"import SwaggerParser from '@apidevtools/swagger-parser'; const api = await SwaggerParser.validate('docs/openapi.yaml', { resolve: { external: false } }); console.log(api.info.title + ' ' + api.info.version + ': valid');\"",
        "build": "vite build",
        "dev": "vite"
    },
    "devDependencies": {
        "@apidevtools/swagger-parser": "^13.1.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
